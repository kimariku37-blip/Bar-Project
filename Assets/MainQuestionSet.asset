  questions:
  - questionText: "\u4ECA\u65E5\u306E\u6C17\u5206\u306F\u4F55\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u5143\u6C17\u3044\u3063\u3071\u3044"
      tag: 0
      masterReaction: "\u305D\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u3001\u826F\u3044\u3067\u3059\u306D\u3002\u4ECA\u65E5\u306F\u304D\u3063\u3068\u3044\u3044\u591C\u306B\u306A\u308A\u307E\u3059\u3088"
    - choiceText: "\u306A\u3093\u3060\u304B\u7518\u3048\u305F\u3044\u6C17\u5206"
      tag: 1
      masterReaction: "\u305F\u307E\u306B\u306F\u305D\u3046\u3044\u3046\u65E5\u304C\u3042\u3063\u3066\u3082\u3044\u3044\u3068\u601D\u3044\u307E\u3059\u3088"
    - choiceText: "\u3044\u3064\u3082\u901A\u308A\u843D\u3061\u7740\u3044\u3066\u308B"
      tag: 2
      masterReaction: "\u3044\u3064\u3082\u901A\u308A\u304C\u4E00\u756A\u306A\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3088\u306D\u3002\u3068\u3066\u3082\u3044\u3044\u3068\u601D\u3044\u307E\u3059\u3088"
    - choiceText: "\u3061\u3087\u3063\u3068\u7269\u601D\u3044\u306B\u3075\u3051\u3063\u3066\u308B"
      tag: 4
      masterReaction: "\u305D\u3046\u3044\u3046\u591C\u3082\u60AA\u304F\u306A\u3044\u3082\u306E\u3067\u3059\u3002\u3086\u3063\u304F\u308A\u3057\u3066\u3044\u3063\u3066\u304F\u3060\u3055\u3044"
  - questionText: "\u4ECA\u591C\u3001\u30D0\u30FC\u306B\u6C42\u3081\u308B\u3082\u306E\u306F\u4F55\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u6C17\u5206\u8EE2\u63DB"
      tag: 0
      masterReaction: "\u305D\u308C\u306A\u3089\u3001\u3074\u3063\u305F\u308A\u306A\u4E00\u676F\u3092\u3054\u7528\u610F\u3067\u304D\u308B\u3068\u601D\u3044\u307E\u3059"
    - choiceText: "\u30EA\u30E9\u30C3\u30AF\u30B9"
      tag: 2
      masterReaction: "\u3053\u3053\u3067\u306F\u80A9\u306E\u529B\u3092\u629C\u3044\u3066\u3001\u3086\u3063\u304F\u308A\u3057\u3066\u3044\u3063\u3066\u304F\u3060\u3055\u3044\u306D"
    - choiceText: "\u7279\u5225\u611F"
      tag: 4
      masterReaction: "\u4ECA\u591C\u304C\u7279\u5225\u306A\u3082\u306E\u306B\u306A\u308B\u3088\u3046\u3001\u8155\u306B\u3088\u308A\u3092\u304B\u3051\u307E\u3059\u3088"
    - choiceText: "\u30B7\u30F3\u30D7\u30EB\u306B\uFF11\u676F"
      tag: 3
      masterReaction: "\u30B7\u30F3\u30D7\u30EB\u304C\u4E00\u756A\u3001\u3068\u3044\u3046\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u304B\u3089\u306D"
  - questionText: "\u597D\u304D\u306A\u5473\u306E\u7CFB\u7D71\u306F\u4F55\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u7518\u3044\u30B9\u30A4\u30FC\u30C4\u7CFB"
      tag: 1
      masterReaction: "\u7518\u3044\u3082\u306E\u3001\u3044\u3044\u3067\u3059\u306D\u3002\u6C17\u5206\u3082\u548C\u3089\u304E\u307E\u3059\u3057"
    - choiceText: "\u67D1\u6A58\u7CFB\u306E\u3055\u3063\u3071\u308A\u7CFB"
      tag: 2
      masterReaction: "\u723D\u3084\u304B\u306A\u9178\u5473\u306F\u3001\u6C17\u5206\u3092\u3059\u3063\u304D\u308A\u3055\u305B\u3066\u304F\u308C\u307E\u3059\u3088"
    - choiceText: "\u30B7\u30F3\u30D7\u30EB\u3067\u98F2\u307F\u3084\u3059\u3044\u7CFB"
      tag: 3
      masterReaction: "\u98F2\u307F\u3084\u3059\u3055\u3092\u5927\u4E8B\u306B\u3059\u308B\u4EBA\u3001\u591A\u3044\u3067\u3059\u3088"
    - choiceText: "\u30B3\u30FC\u30D2\u30FC\u3084\u30C1\u30E7\u30B3\u307F\u305F\u3044\u306A\u5927\u4EBA\u306E\u82E6\u5473\u7CFB"
      tag: 5
      masterReaction: "\u6E0B\u3044\u597D\u307F\u3067\u3059\u306D\u3001\u305D\u3046\u3044\u3046\u304A\u5BA2\u3055\u3093\u306F\u5ACC\u3044\u3058\u3083\u306A\u3044\u3067\u3059"
  - questionText: "\u4ECA\u591C\u306F\u3069\u3093\u306A\u591C\u306B\u3057\u305F\u3044\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u30D1\u30FC\u3063\u3068\u76DB\u308A\u4E0A\u304C\u308A\u305F\u3044"
      tag: 0
      masterReaction: "\u305D\u308C\u306F\u697D\u3057\u307F\u3067\u3059\u306D\u3001\u3053\u3061\u3089\u3082\u8155\u304C\u9CF4\u308A\u307E\u3059"
    - choiceText: "\u3061\u3087\u3063\u3068\u7279\u5225\u306A\u6C17\u5206\u306B\u6D78\u308A\u305F\u3044"
      tag: 4
      masterReaction: "\u4ECA\u591C\u304C\u3001\u305D\u3093\u306A\u591C\u306B\u306A\u308B\u3068\u3044\u3044\u3067\u3059\u306D"
    - choiceText: "\u6C17\u53D6\u3089\u305A\u30EA\u30E9\u30C3\u30AF\u30B9\u3057\u305F\u3044"
      tag: 3
      masterReaction: "\u80A9\u8098\u5F35\u3089\u305A\u306B\u3001\u3086\u3063\u304F\u308A\u3057\u3066\u3044\u3063\u3066\u304F\u3060\u3055\u3044"
    - choiceText: "\u8AB0\u304B\u306B\u7518\u3048\u305F\u3044\u3088\u3046\u306A\u591C"
      tag: 1
      masterReaction: "\u305D\u3046\u3044\u3046\u591C\u3001\u8AB0\u306B\u3067\u3082\u3042\u308B\u3068\u601D\u3044\u307E\u3059\u3088"
  - questionText: "\u666E\u6BB5\u306E\u81EA\u5206\u306B\u8FD1\u3044\u306E\u306F\u3069\u308C\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u30A2\u30AF\u30C6\u30A3\u30D6\u3067\u793E\u4EA4\u7684"
      tag: 0
      masterReaction: "\u30A8\u30CD\u30EB\u30AE\u30C3\u30B7\u30E5\u306A\u4EBA\u306F\u3001\u898B\u3066\u3044\u3066\u6C17\u6301\u3061\u304C\u3044\u3044\u3082\u306E\u3067\u3059"
    - choiceText: "\u3053\u3060\u308F\u308A\u304C\u5F37\u304F\u4E00\u672C\u82AF\u304C\u901A\u3063\u3066\u308B"
      tag: 5
      masterReaction: "\u82AF\u306E\u3042\u308B\u4EBA\u3001\u5ACC\u3044\u3058\u3083\u306A\u3044\u3067\u3059\u3088"
    - choiceText: "\u30DE\u30A4\u30DA\u30FC\u30B9\u3067\u81EA\u5206\u306E\u6642\u9593\u3092\u5927\u4E8B\u306B\u3059\u308B"
      tag: 2
      masterReaction: "\u81EA\u5206\u306E\u30DA\u30FC\u30B9\u3092\u5927\u4E8B\u306B\u3059\u308B\u306E\u3001\u7D20\u6575\u3060\u3068\u601D\u3044\u307E\u3059\u3088"
    - choiceText: "\u8AB0\u306B\u3067\u3082\u5408\u308F\u305B\u3089\u308C\u308B\u67D4\u8EDF\u6D3E"
      tag: 3
      masterReaction: "\u67D4\u8EDF\u3055\u3063\u3066\u3001\u5B9F\u306F\u4E00\u756A\u306E\u5F37\u307F\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u306D"
  - questionText: "\u597D\u304D\u306A\u5B63\u7BC0\u306F\u4F55\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u6625"
      tag: 1
      masterReaction: "\u6625\u306F\u4F55\u304B\u65B0\u3057\u3044\u3053\u3068\u304C\u59CB\u307E\u308B\u5B63\u7BC0\u3067\u3059\u3082\u3093\u306D"
    - choiceText: "\u590F"
      tag: 0
      masterReaction: "\u590F\u306F\u3084\u3063\u3071\u308A\u3001\u307F\u3093\u306A\u5143\u6C17\u306B\u306A\u308A\u307E\u3059\u3088\u306D"
    - choiceText: "\u79CB"
      tag: 5
      masterReaction: "\u79CB\u306E\u591C\u9577\u3001\u3057\u3063\u3068\u308A\u3057\u305F\u304A\u9152\u304C\u604B\u3057\u304F\u306A\u308B\u5B63\u7BC0\u3067\u3059"
    - choiceText: "\u51AC"
      tag: 3
      masterReaction: "\u5BD2\u3044\u5B63\u7BC0\u306F\u3001\u6E29\u307E\u308B\u4E00\u676F\u304C\u604B\u3057\u304F\u306A\u308A\u307E\u3059\u306D"
  - questionText: "\u4ECA\u65E5\u3092\u4E00\u8A00\u3067\u8868\u3059\u3068\u3069\u3093\u306A\u65E5\u3067\u3059\u304B\uFF1F"
    choices:
    - choiceText: "\u697D\u3057\u304B\u3063\u305F"
      tag: 1
      masterReaction: "\u305D\u308C\u306F\u4F55\u3088\u308A\u3067\u3059\u3001\u3044\u3044\u4E00\u65E5\u3067\u3057\u305F\u306D"
    - choiceText: "\u9811\u5F35\u3063\u305F"
      tag: 3
      masterReaction: "\u304A\u75B2\u308C\u69D8\u3067\u3057\u305F\u3001\u4ECA\u65E5\u304F\u3089\u3044\u306F\u3086\u3063\u304F\u308A\u3057\u3066\u304F\u3060\u3055\u3044"
    - choiceText: "\u5FAE\u5999\u3060\u3063\u305F"
      tag: 0
      masterReaction: "\u305D\u3046\u3044\u3046\u65E5\u3082\u3042\u308A\u307E\u3059\u3088\u3001\u6C17\u5206\u3092\u5909\u3048\u3066\u3044\u304D\u307E\u3057\u3087\u3046"
    - choiceText: "\u7279\u306B\u4F55\u3082\u306A\u304B\u3063\u305F"
      tag: 2
      masterReaction: "\u7A4F\u3084\u304B\u306A\u4E00\u65E5\u3060\u3063\u305F\u3093\u3067\u3059\u306D\u3001\u305D\u308C\u3082\u307E\u305F\u826F\u3044\u3082\u306E\u3067\u3059"
